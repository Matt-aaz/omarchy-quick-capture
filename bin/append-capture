#!/usr/bin/python3
"""Save or append one bounded capture through verified file descriptors."""

import errno
import fcntl
import os
import re
import stat
import sys
import urllib.parse

MAX_NOTE_BYTES = 256 * 1024

KNOWN_DOMAINS = {
    "youtube.com": "YouTube",
    "youtu.be": "YouTube",
    "instagram.com": "Instagram",
    "tiktok.com": "TikTok",
    "twitter.com": "X",
    "x.com": "X",
    "github.com": "GitHub",
    "gitlab.com": "GitLab",
    "reddit.com": "Reddit",
    "wikipedia.org": "Wikipedia",
    "news.ycombinator.com": "Hacker News",
    "stackoverflow.com": "Stack Overflow",
    "medium.com": "Medium",
    "linkedin.com": "LinkedIn",
    "facebook.com": "Facebook",
    "threads.net": "Threads",
    "pinterest.com": "Pinterest",
    "twitch.tv": "Twitch",
    "spotify.com": "Spotify",
    "nytimes.com": "New York Times",
    "bbc.com": "BBC",
    "bbc.co.uk": "BBC",
}

GENERIC_SLUGS = {
    "watch",
    "item",
    "p",
    "pd",
    "v",
    "video",
    "videos",
    "post",
    "posts",
    "view",
    "index",
    "default",
    "show",
    "article",
    "feed",
    "home",
}


class CaptureError(Exception):
    def __init__(self, message: str, exit_code: int) -> None:
        super().__init__(message)
        self.message = message
        self.exit_code = exit_code


def read_payload() -> bytes:
    try:
        payload = sys.stdin.buffer.read(MAX_NOTE_BYTES + 1)
    except OSError as exc:
        raise CaptureError("Could not read the note content.", 6) from exc

    if len(payload) > MAX_NOTE_BYTES:
        raise CaptureError(
            "Could not save note: note exceeds the 256 KiB limit.", 6
        )

    payload = payload.rstrip(b"\n")
    if not payload:
        raise CaptureError("Could not save note: capture is empty.", 7)
    return payload


def validate_path(value: str) -> str:
    if not value:
        raise CaptureError("Capture path is invalid.", 2)
    if not os.path.isabs(value):
        raise CaptureError("Capture path is invalid: use an absolute path.", 2)
    if "\0" in value:
        raise CaptureError("Capture path is invalid.", 2)
    return value


def create_parent(path: str) -> None:
    parent = os.path.dirname(path) or "/"
    try:
        os.makedirs(parent, mode=0o700, exist_ok=True)
    except OSError as exc:
        raise CaptureError("Could not create the capture directory.", 4) from exc


def is_url(text: str) -> bool:
    return bool(re.match(r"^(https?://|www\.)\S+", text.strip(), re.IGNORECASE))


def clean_domain_name(netloc: str) -> str:
    host = netloc.split(":")[0].lower()
    host = re.sub(r"^(?:www\d?|m|mobile|amp)\.", "", host)

    for domain, name in KNOWN_DOMAINS.items():
        if host == domain or host.endswith("." + domain):
            return name

    parts = host.split(".")
    if len(parts) >= 2:
        if len(parts) >= 3 and len(parts[-1]) <= 3 and len(parts[-2]) <= 3:
            main_part = parts[-3]
        else:
            main_part = parts[-2]
    else:
        main_part = parts[0]

    words = re.split(r"[-_]+", main_part)
    return " ".join(w.capitalize() for w in words if w)


def extract_url_title(url_str: str) -> str:
    try:
        clean_url = url_str.strip()
        if not clean_url.startswith(("http://", "https://")):
            clean_url = "https://" + clean_url
        parsed = urllib.parse.urlparse(clean_url)
        host = parsed.netloc.lower()
        path = parsed.path

        if ("youtube.com" in host or "youtu.be" in host) and "/shorts" in path.lower():
            return "YouTube Short"
        if "instagram.com" in host and ("/reel" in path.lower() or "/reels" in path.lower()):
            return "Instagram Reel"

        site_name = clean_domain_name(parsed.netloc)

        segments = [s for s in path.strip("/").split("/") if s]
        slug = ""
        if segments:
            last = urllib.parse.unquote(segments[-1])
            if not re.match(r"^[\da-fA-F]{16,}$|^\d+$", last):
                clean_slug = re.sub(r"\.html?$", "", last)
                clean_slug = re.sub(r"[-_]+", " ", clean_slug).strip()
                if (
                    clean_slug.lower() not in GENERIC_SLUGS
                    and len(clean_slug) >= 3
                    and not re.match(r"^[a-zA-Z0-9]{8,15}$", clean_slug)
                ):
                    if len(clean_slug) > 40:
                        clean_slug = clean_slug[:40].rsplit(" ", 1)[0]
                    slug = clean_slug.capitalize()

        if slug and slug.lower() != site_name.lower():
            return f"{site_name} - {slug}"
        return site_name or "Link"
    except Exception:
        return "Link"


def extract_title_slug(payload: bytes) -> str:
    try:
        text = payload.decode("utf-8", errors="replace")
    except Exception:
        return ""

    lines = text.split("\n")
    non_url_title = ""
    url_fallback = ""

    for line in lines:
        stripped = line.strip()
        if not stripped:
            continue
        # Skip markdown headings that look like timestamps (e.g. ## 2026-08-28...)
        if re.match(r"^#+\s*\d{4}-\d{2}-\d{2}", stripped):
            continue
        # Skip pure tag lines (e.g. #capture #work)
        if re.match(r"^(#[a-zA-Z0-9_\-\/]+\s*)+$", stripped):
            continue

        # If the line is a URL, extract smart platform/domain title as fallback
        if is_url(stripped) or re.search(r"^https?://", stripped, re.IGNORECASE):
            if not url_fallback:
                url_fallback = extract_url_title(stripped)
            continue

        # Clean markdown formatting and invalid filesystem characters
        clean = re.sub(r"^[#*>\-\s\[\]xX]+", "", stripped)
        clean = re.sub(r"[`*_~]", "", clean)
        clean = re.sub(r'[/\\:*?"<>|#^\[\]]', "", clean).strip()
        if clean:
            if len(clean) > 60:
                clean = clean[:60].rsplit(" ", 1)[0].strip()
            non_url_title = clean
            break

    if non_url_title:
        return non_url_title
    if url_fallback:
        return url_fallback
    return ""


def save_separate_file(directory: str, payload: bytes) -> None:
    os.makedirs(directory, mode=0o700, exist_ok=True)
    title = extract_title_slug(payload)
    if not title:
        title = "Quick Note"

    base_name = f"{title}.md"
    target_path = os.path.join(directory, base_name)
    counter = 1
    while os.path.exists(target_path):
        target_path = os.path.join(directory, f"{title} {counter}.md")
        counter += 1

    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        fd = os.open(target_path, flags, 0o600)
    except OSError as exc:
        raise CaptureError("Could not create the new note file.", 8) from exc

    try:
        write_all(fd, payload + b"\n")
        try:
            os.fsync(fd)
        except OSError as exc:
            raise CaptureError("Could not save note: disk flush failed.", 11) from exc
    finally:
        os.close(fd)


def open_destination(path: str) -> int:
    flags = (
        os.O_RDWR
        | os.O_APPEND
        | os.O_CREAT
        | os.O_NONBLOCK
        | os.O_CLOEXEC
        | os.O_NOFOLLOW
    )
    try:
        return os.open(path, flags, 0o600)
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise CaptureError(
                "Could not save note: destination is a symbolic link.", 3
            ) from exc
        if exc.errno in {
            errno.EISDIR,
            errno.ENXIO,
            errno.ENODEV,
            getattr(errno, "ENOTSUP", errno.EINVAL),
            errno.EOPNOTSUPP,
        }:
            raise CaptureError(
                "Could not save note: destination is not a regular file.", 3
            ) from exc
        raise CaptureError("Could not create or open the capture file.", 8) from exc


def verify_regular(fd: int) -> os.stat_result:
    try:
        info = os.fstat(fd)
    except OSError as exc:
        raise CaptureError("Could not inspect the capture file.", 8) from exc
    if not stat.S_ISREG(info.st_mode):
        raise CaptureError(
            "Could not save note: destination is not a regular file.", 3
        )
    return info


def write_all(fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except OSError as exc:
            raise CaptureError("Could not save note: disk write failed.", 10) from exc
        if written <= 0:
            raise CaptureError("Could not save note: disk write failed.", 10)
        view = view[written:]


def append_capture(path: str, payload: bytes) -> None:
    fd = open_destination(path)
    locked = False
    try:
        verify_regular(fd)

        current_flags = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, current_flags & ~os.O_NONBLOCK)

        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            locked = True
        except OSError as exc:
            raise CaptureError("Could not lock the capture file.", 9) from exc

        info = verify_regular(fd)
        separator = b""
        if info.st_size:
            try:
                last_byte = os.pread(fd, 1, info.st_size - 1)
            except OSError as exc:
                raise CaptureError("Could not inspect the capture file.", 8) from exc
            separator = b"\n" if last_byte == b"\n" else b"\n\n"

        write_all(fd, separator + payload + b"\n")
        try:
            os.fsync(fd)
        except OSError as exc:
            raise CaptureError("Could not save note: disk flush failed.", 11) from exc
    finally:
        if locked:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(fd)


def main(argv: list[str]) -> int:
    os.umask(0o077)
    try:
        path = validate_path(argv[1] if len(argv) > 1 else "")
        if len(argv) != 2:
            raise CaptureError("Capture path is invalid.", 2)
        payload = read_payload()

        if os.path.isdir(path) or not path.endswith(".md"):
            save_separate_file(path, payload)
        else:
            create_parent(path)
            append_capture(path, payload)
    except CaptureError as exc:
        print(exc.message, file=sys.stderr)
        return exc.exit_code
    except (OSError, ValueError) as err:
        print(f"Could not save note due to an unexpected file error: {err}", file=sys.stderr)
        return 12
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
